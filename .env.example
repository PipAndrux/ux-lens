# Copy to .env and fill in. Never commit .env.
# AI provider: mock (default, free, sample results) or claude (real analyses, billed per call).
UXLENS_AI_PROVIDER=mock
# Only needed with UXLENS_AI_PROVIDER=claude. The app refuses to start with claude and no key.
ANTHROPIC_API_KEY=
POSTGRES_DB=uxlens
POSTGRES_USER=uxlens
POSTGRES_PASSWORD=uxlens
